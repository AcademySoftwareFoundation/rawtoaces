cmake_minimum_required(VERSION 3.10)

set(rawtoaces_VERSION "@RAWTOACES_VERSION@")

@PACKAGE_INIT@

set( _supported_components rawtoaces_core rawtoaces_util )
set( _requested_components ${RAWTOACES_FIND_COMPONENTS} )

if ( NOT _requested_components )
    set( _requested_components rawtoaces_core rawtoaces_util )
endif()

foreach( _comp IN LISTS _requested_components )
  if ( NOT _comp IN_LIST _supported_components )
    set( RAWTOACES_FOUND False )
    set( RAWTOACES_NOT_FOUND_MESSAGE "Unsupported component: ${_comp}" )
  endif()
endforeach()

include(CMakeFindDependencyMacro)

if ( NOT @ENABLE_SHARED@ )
    find_dependency ( nlohmann_json )

    if ( @RTA_ENABLE_EIGEN@ )
        find_dependency ( Eigen3 )
    endif ()
    
    if ( @RTA_ENABLE_CERES@ )
        find_dependency ( Ceres )
    endif ()
endif ( NOT @ENABLE_SHARED@ )

include( "${CMAKE_CURRENT_LIST_DIR}/RAWTOACESCoreTargets.cmake" )

if ( "rawtoaces_util" IN_LIST _requested_components )
    find_dependency ( OpenImageIO )
    include( "${CMAKE_CURRENT_LIST_DIR}/RAWTOACESUtilTargets.cmake" )
endif ()
